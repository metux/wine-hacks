# wine launcher
debian/tmp/wineDEBSUFFIX usr/bin

# wine application loader
debian/tmp/usr/lib/wineVERSION/wineapploader usr/lib/wineVERSION

# wine icon
debian/tmp/wineDEBSUFFIX.svg usr/share/icons/hicolor/scalable/apps/

# application metadata
debian/org.winehq.wineVERSION.appdata.xml usr/share/metainfo/
